{
  "name": "tfm-iaap-frontend-administracion",
  "version": "1.0.1-SNAPSHOT",
  "license": "EUPL-1.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "check:version": "node scripts/check-version.mjs",
    "build": "node scripts/check-version.mjs && ng build",
    "build:rocky": "node scripts/check-version.mjs && ng build --base-href /sicol/",
    "generate:api": "openapi-typescript ../tfm-iaap-backend/contracts/openapi/sicol-v1.yaml -o src/app/api/generated/sicol-api.ts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false"
  },
  "dependencies": {
    "@angular/common": "^21.2.20",
    "@angular/compiler": "^21.2.20",
    "@angular/core": "^21.2.20",
    "@angular/forms": "^21.2.20",
    "@angular/platform-browser": "^21.2.20",
    "@angular/router": "^21.2.20",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.20",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "~5.9.0"
  }
}
